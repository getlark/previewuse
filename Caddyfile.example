# Caddyfile for the preview environment.
#
# Caddy automatically issues TLS certs from Let's Encrypt for each host. The
# host env vars (DASHBOARD_HOST, API_HOST, ...) are populated by deploy.sh and
# correspond to the PREVIEW_HOSTS entries in your preview.config.sh.
#
# Add a block per host, routing to the appropriate compose service:port.

{$DASHBOARD_HOST} {
	reverse_proxy dashboard:80
}

{$API_HOST} {
	reverse_proxy api:8000
}
